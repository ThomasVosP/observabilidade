# ─── Supabase — projeto "Observabilidade" (uzjmdiazousqdvyykshr) ───
#
# Duas opções de conexão Postgres:
#
# 1. Pooler (recomendado — IPv4, funciona em qualquer rede)
#    Port 6543 = transaction mode (ideal para inserts em batch / execute_values)
#    Port 5432 do pooler = session mode (use se precisar PREPARE/cursors)
DATABASE_URL=postgresql://postgres.uzjmdiazousqdvyykshr:SENHA_AQUI@aws-1-sa-east-1.pooler.supabase.com:6543/postgres
#
# 2. Conexão direta (port 5432) — só funciona em redes com IPv6
#    host: db.uzjmdiazousqdvyykshr.supabase.co | port: 5432 | user: postgres | database: postgres
# DATABASE_URL=postgresql://postgres:SENHA_AQUI@db.uzjmdiazousqdvyykshr.supabase.co:5432/postgres

SUPABASE_URL=https://uzjmdiazousqdvyykshr.supabase.co
# SUPABASE_SERVICE_KEY=  # opcional — apenas se for usar supabase-py em vez de psycopg2

